# Copy file này thành .env rồi sửa lại giá trị:
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS / Linux / Git Bash: cp .env.example .env

# Mật khẩu tài khoản sa của SQL Server.
# Yêu cầu: >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
MSSQL_SA_PASSWORD=ClothingStore@2026

# Khóa ký JWT: chuỗi ngẫu nhiên, BẮT BUỘC >= 32 ký tự.
JWT_SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai-it-nhat-32-ky-tu
JWT_ISSUER=ClothingStoreAPI
JWT_AUDIENCE=ClothingStoreAngular

# Pepper (khóa HMAC-SHA256) để băm mã khôi phục 2FA: chuỗi ngẫu nhiên, BẮT BUỘC >= 32 ký tự.
# Tạo bằng PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Chỉ lộ DB mà không lộ pepper thì không dò ngược được mã khôi phục.
# CẢNH BÁO: mất hoặc đổi pepper => TOÀN BỘ mã khôi phục đã phát không dùng được nữa, người dùng phải tạo lại.
TWO_FACTOR_RECOVERY_PEPPER=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# CAPTCHA Cloudflare Turnstile (bắt buộc khi TURNSTILE_ENABLED=true).
# Lấy ở Cloudflare Dashboard -> Turnstile -> chọn widget -> Settings -> "Secret Key".
# Site key (công khai) đặt ở frontend: shop-clothing-ui/src/environments/environment*.ts (turnstileSiteKey).
# Khóa thử nghiệm của Cloudflare (không cần tài khoản):
#   luôn đạt:  site key 1x00000000000000000000AA  / secret 1x0000000000000000000000000000000AA
#   luôn trượt: site key 2x00000000000000000000AB / secret 2x0000000000000000000000000000000AA
# Nếu sau này thêm Content-Security-Policy (nginx hoặc <meta> trong index.html) thì PHẢI cho phép
# https://challenges.cloudflare.com ở script-src và frame-src, nếu không widget CAPTCHA sẽ không chạy.
TURNSTILE_SECRET_KEY=
# Chỉ đặt false khi dev/test: tắt hẳn CAPTCHA (API ghi log Warning mỗi lần khởi động).
# TURNSTILE_ENABLED=true
# CHỈ DÙNG ĐỂ KIỂM THỬ: giả lập mất mạng ra Cloudflare. Bình thường để trống.
# TURNSTILE_VERIFY_URL=http://10.255.255.1/

# Tài khoản admin tạo tự động ở lần chạy đầu tiên.
ADMIN_EMAIL=admin@clothingstore.local
ADMIN_PASSWORD=Admin@123

# (Tùy chọn) Gửi email quên mật khẩu qua Gmail — để trống nếu không dùng.
# AppPassword là "Mật khẩu ứng dụng" 16 ký tự tạo ở tài khoản Google, không phải mật khẩu Gmail.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=

# (Tùy chọn) Đường dẫn tới repo frontend, tính từ thư mục này.
# Mặc định là ../shop-clothing-ui (2 repo nằm cạnh nhau).
# FRONTEND_PATH=../shop-clothing-ui
